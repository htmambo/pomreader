{
  "name": "pomreader",
  "version": "1.0.0",
  "description": "白虎阅读 — Angular + Electron 跨平台阅读器",
  "author": "果农 <guonong@hongshu.com>",
  "homepage": "https://github.com/htmambo/pomreader",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:electron": "tsc -p electron/tsconfig.electron.json",
    "watch:electron": "tsc -p electron/tsconfig.electron.json --watch",
    "electron": "npm run build:electron && electron .",
    "dev": "concurrently -k -n web,ele \"ng build --watch --configuration development\" \"npm run watch:electron\" \"wait-on electron/www/browser/index.html && electron .\"",
    "dev:file": "concurrently -k -n web,ele \"ng build --watch --configuration development\" \"npm run watch:electron\" \"wait-on electron/www/browser/index.html && electron .\"",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@ant-design/icons-angular": "^18.0.0",
    "@ctrl/tinycolor": "^4.2.1",
    "@types/pouchdb-browser": "^6.1.5",
    "ng-zorro-antd": "^18.2.1",
    "pouchdb-browser": "^9.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "iconv-lite": "^0.6.3",
    "jasmine-core": "~5.2.0",
    "jsdom": "^26.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.5.2",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.baihu.reader",
    "productName": "白虎阅读",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "electron/www/**/*",
      "electron/preload.js",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG,README,readme,readme.md,*.markdown,*.md,*.map}",
      "!**/node_modules/.cache",
      "!**/{.DS_Store,.git,.github,test,tests,docs,doc,coverage,example,examples}"
    ],
    "linux": {
      "target": [
        "tar.gz",
        "pacman"
      ],
      "category": "Office",
      "maintainer": "果农 <guonong@hongshu.com>",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "Name": "白虎阅读",
          "Comment": "Angular + Electron 跨平台小说阅读器",
          "Categories": "Office;Utility;"
        }
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  }
}
