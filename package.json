{
  "name": "pomreader",
  "version": "1.0.0",
  "description": "白虎阅读 — Angular + Electron 跨平台阅读器",
  "author": "果农 <guonong@hongshu.com>",
  "homepage": "https://github.com/htmambo/pomreader",
  "main": "dist-electron/main.js",
  "desktopName": "pomreader.desktop",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:worker": "esbuild src/app/core/book-source/js-source/sandbox.worker.ts --bundle --target=es2020 --format=iife --outfile=src/assets/sandbox.worker.js",
    "build": "npm run build:worker && ng build",
    "watch": "npm run build:worker && ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json,md}\" \"electron/**/*.ts\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json,md}\" \"electron/**/*.ts\" \"*.{json,md,ts}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build:electron": "tsc -p electron/tsconfig.electron.json && npm run build:db-window",
    "build:db-window": "esbuild electron/db/db-renderer.ts --bundle --platform=browser --target=es2020 --format=iife --external:electron --outfile=dist-electron/db-renderer.js && cp electron/db/db-window.html dist-electron/db-window.html",
    "watch:electron": "tsc -p electron/tsconfig.electron.json --watch",
    "electron": "npm run build && npm run build:electron && electron .",
    "dev": "npm run build:db-window && concurrently -k -n web,ele \"ng serve --port 4200\" \"npm run watch:electron\" \"wait-on http://localhost:4200 && cross-env POM_DEV_URL=http://localhost:4200 electron .\"",
    "dev:file": "npm run build:db-window && rm -rf electron/www && concurrently -k -n web,ele \"ng build --watch --configuration development\" \"npm run watch:electron\" \"wait-on electron/www/browser/index.html && electron .\"",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/localize": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@ant-design/icons-angular": "^21.0.0",
    "@ctrl/tinycolor": "^4.2.1",
    "@types/pouchdb-browser": "^6.1.5",
    "adm-zip": "^0.6.1",
    "iconv-lite": "^0.7.3",
    "ng-zorro-antd": "^21.3.3",
    "opencc-js": "^1.4.2",
    "pouchdb-browser": "^9.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "valibot": "^1.5.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.15.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^21.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "eslint": "^9.39.5",
    "events": "^3.3.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.baihu.reader",
    "productName": "白虎阅读",
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "files": [
      "dist-electron/**/*",
      "electron/www/**/*",
      "electron/icons/**/*",
      "electron/preload.js",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG,README,readme,readme.md,*.markdown,*.md,*.map}",
      "!**/node_modules/.cache",
      "!**/{.DS_Store,.git,.github,test,tests,docs,doc,coverage,example,examples}"
    ],
    "linux": {
      "target": [
        "tar.gz",
        "pacman"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "果农 <guonong@hongshu.com>",
      "icon": "electron/icons",
      "desktop": {
        "entry": {
          "Name": "白虎阅读",
          "Comment": "Angular + Electron 跨平台小说阅读器",
          "Categories": "Office;Utility;"
        }
      }
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "pacman": {
      "afterInstall": "electron/scripts/after-install.sh"
    }
  }
}
