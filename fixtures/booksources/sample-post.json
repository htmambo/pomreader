{
  "format": "pomreader.booksource",
  "schemaVersion": 1,
  "uuid": "sample-post.json",
  "name": "样本POST站",
  "author": "智能添加",
  "description": "差分测试样本 sample-post（中性占位，非真实站点）",
  "homepage": "https://sample-post.invalid",
  "urls": [
    "https://sample-post.invalid"
  ],
  "enabled": true,
  "sourceType": "novel",
  "sourceVersion": "1.2.0",
  "tags": [
    "智能识别"
  ],
  "minDelayMs": 0,
  "requireUrls": [],
  "headers": {
    "X-Requested-With": "XMLHttpRequest",
    "Referer": "https://sample-post.invalid/"
  },
  "rules": {
    "siteName": "样本POST站",
    "searchPath": "/search",
    "searchMethod": "POST",
    "searchBodyParams": [
      {
        "key": "q",
        "value": "{keyword}"
      },
      {
        "key": "page",
        "value": "{page}"
      }
    ],
    "searchItemPattern": "<div class=\"item\">[\\s\\S]*?<a href=\"([^\"]+)\">([^<]+)</a>",
    "searchAuthorPattern": "<em>([^<]+)</em>",
    "searchCategoryPattern": "<i>([^<]+)</i>",
    "bookTitlePattern": "<h1[^>]*>([\\s\\S]*?)</h1>",
    "bookAuthorPattern": "作者[：:]\\s*([^<]{1,30})",
    "bookCategoryPattern": "分类[：:]\\s*([^<]{1,20})",
    "chapterItemPattern": "<a href=\"(/book/\\d+/chapter/\\d+)\">([^<]+)</a>",
    "contentPattern": "<div[^>]+id=\"content\"[^>]*>([\\s\\S]*?)</div>",
    "coverUrlPattern": "<img[^>]+src=\"([^\"]+)\""
  }
}
