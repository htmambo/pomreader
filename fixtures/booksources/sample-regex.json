{
  "format": "pomreader.booksource",
  "schemaVersion": 1,
  "uuid": "sample-regex.json",
  "name": "样本正则站",
  "author": "智能添加",
  "description": "差分测试样本 sample-regex（中性占位，非真实站点）",
  "homepage": "https://sample-regex.invalid",
  "urls": [
    "https://sample-regex.invalid"
  ],
  "enabled": true,
  "sourceType": "novel",
  "sourceVersion": "1.2.0",
  "tags": [
    "智能识别"
  ],
  "minDelayMs": 0,
  "requireUrls": [],
  "headers": {},
  "rules": {
    "siteName": "样本正则站",
    "searchPath": "/search?q={keyword}&p={page}",
    "searchItemPattern": "<a href=\"(/book/\\d+)\">([^<]+)</a>",
    "bookTitlePattern": "<h1[^>]*>([\\s\\S]*?)</h1>",
    "bookAuthorPattern": "作者[：:]\\s*([^<]{1,30})",
    "bookCategoryPattern": "分类[：:]\\s*([^<]{1,20})",
    "chapterItemPattern": "<a href=\"(/book/\\d+/chapter/\\d+)\">([^<]+)</a>",
    "contentPattern": "<div[^>]+id=\"content\"[^>]*>([\\s\\S]*?)</div>",
    "coverUrlPattern": "<img[^>]+src=\"([^\"]+)\""
  }
}
